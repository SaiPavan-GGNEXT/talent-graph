# Copy to .env and fill in — never commit the real values.
# CognoDB Cloud: create a free c0 instance at https://console.cognodb.com
# and copy the connection URI + one-time password it shows you.

NEO4J_URI=bolt+s://<instance-id>.databases.cognodb.cloud
NEO4J_USER=cognodb
NEO4J_PASSWORD=<your-password>

# Optional
PORT=8080
STATIC_DIR=frontend/dist
